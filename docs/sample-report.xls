 <Worksheet ss:Name="Сводка"><Table><Row><Cell ss:StyleID="head"><Data ss:Type="String">Показатель</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Значение</Data></Cell></Row><Row><Cell><Data ss:Type="String">Проект</Data></Cell><Cell><Data ss:Type="String">Экспресс-оценка роботизации — демо-склад 40 × 24 м</Data></Cell></Row><Row><Cell><Data ss:Type="String">Тип объекта</Data></Cell><Cell><Data ss:Type="String">Склад</Data></Cell></Row><Row><Cell><Data ss:Type="String">Решение</Data></Cell><Cell><Data ss:Type="String">Ronavi H1500, ООО «Ронави Роботикс»</Data></Cell></Row><Row><Cell><Data ss:Type="String">Дата расчёта</Data></Cell><Cell><Data ss:Type="String">27.09.2026, 16:18:16</Data></Cell></Row><Row><Cell><Data ss:Type="String">Версия каталога</Data></Cell><Cell><Data ss:Type="Number">4</Data></Cell></Row><Row><Cell><Data ss:Type="String">Версия модели</Data></Cell><Cell><Data ss:Type="String">Экономическая модель v2 (экономисты), CAPEX §16.3</Data></Cell></Row><Row><Cell><Data ss:Type="String">Источник ТТХ робота</Data></Cell><Cell><Data ss:Type="String">каталог робототехников, данные производителя</Data></Cell></Row><Row></Row><Row><Cell><Data ss:Type="String">Пиковая потребность, ед/ч</Data></Cell><Cell><Data ss:Type="Number">327.3</Data></Cell></Row><Row><Cell><Data ss:Type="String">Эффективная производительность робота, ед/ч</Data></Cell><Cell><Data ss:Type="Number">63</Data></Cell></Row><Row><Cell><Data ss:Type="String">Требуется роботов, шт</Data></Cell><Cell><Data ss:Type="Number">6</Data></Cell></Row><Row><Cell><Data ss:Type="String">Замещается персонала, чел.</Data></Cell><Cell><Data ss:Type="Number">10</Data></Cell></Row><Row></Row><Row><Cell><Data ss:Type="String">CAPEX, ₽</Data></Cell><Cell><Data ss:Type="Number">34901900</Data></Cell></Row><Row><Cell><Data ss:Type="String">OPEX, ₽/год</Data></Cell><Cell><Data ss:Type="Number">7820640</Data></Cell></Row><Row><Cell><Data ss:Type="String">Годовой эффект, ₽/год</Data></Cell><Cell><Data ss:Type="Number">7803360</Data></Cell></Row><Row><Cell><Data ss:Type="String">Срок окупаемости, лет</Data></Cell><Cell><Data ss:Type="Number">4.47</Data></Cell></Row><Row><Cell><Data ss:Type="String">Зона по сроку окупаемости</Data></Cell><Cell><Data ss:Type="String">вне приемлемых границ</Data></Cell></Row><Row><Cell><Data ss:Type="String">ROI за 5 лет, %</Data></Cell><Cell><Data ss:Type="Number">12</Data></Cell></Row><Row><Cell><Data ss:Type="String">Зона по ROI</Data></Cell><Cell><Data ss:Type="String">требует проверки</Data></Cell></Row><Row><Cell><Data ss:Type="String">TCO за 5 лет, ₽</Data></Cell><Cell><Data ss:Type="Number">74005100</Data></Cell></Row><Row><Cell><Data ss:Type="String">CAPEX / бюджет, %</Data></Cell><Cell><Data ss:Type="Number">44</Data></Cell></Row><Row><Cell><Data ss:Type="String">Зона по бюджету</Data></Cell><Cell><Data ss:Type="String">в зелёной зоне</Data></Cell></Row><Row></Row><Row><Cell><Data ss:Type="String">Дисклеймер</Data></Cell><Cell><Data ss:Type="String">Предварительная оценка. Результат требует верификации при обследовании объекта.</Data></Cell></Row></Table></Worksheet><Worksheet ss:Name="Сценарии"><Table><Row><Cell ss:StyleID="head"><Data ss:Type="String">Показатель</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Без роботизации</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Покупка роботов</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">RaaS</Data></Cell></Row><Row><Cell><Data ss:Type="String">Разовые затраты (CAPEX), ₽</Data></Cell><Cell><Data ss:Type="Number">0</Data></Cell><Cell><Data ss:Type="Number">34901900</Data></Cell><Cell><Data ss:Type="Number">0</Data></Cell></Row><Row><Cell><Data ss:Type="String">OPEX, ₽/год</Data></Cell><Cell><Data ss:Type="Number">15624000</Data></Cell><Cell><Data ss:Type="Number">7820640</Data></Cell><Cell><Data ss:Type="Number">18000000</Data></Cell></Row><Row><Cell><Data ss:Type="String">Годовой эффект, ₽/год</Data></Cell><Cell><Data ss:Type="Number">0</Data