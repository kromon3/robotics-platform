# Локальный запуск с хоста (npm run start:dev, prisma CLI).
# База — контейнер из корневого docker-compose: docker compose up -d db
DATABASE_URL="postgresql://robotics:robotics@localhost:5433/robotics?schema=public"

JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# Подпись cookie админки (/admin). Если не задано — берётся JWT_SECRET.
ADMIN_COOKIE_SECRET="change-me-too"

PORT=3000

SEED_ADMIN_EMAIL=admin@robotics.local
SEED_ADMIN_PASSWORD=admin12345
