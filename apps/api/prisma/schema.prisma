generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid(7))
  email    String  @unique
  name     String  @unique
  password String
  avatar   String?

  UserRole UserRole[]

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  @@index([name])
  @@index([email])
}

// RBAC через таблицы: роли назначаются пользователю через UserRole.
// Базовые роли USER и ADMIN создаёт сид.
model Role {
  id          String     @id @default(uuid(7))
  name        String     @unique
  description String?
  permissions String[]
  priority    Int        @default(0)
  UserRole    UserRole[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([name])
}

model UserRole {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}
