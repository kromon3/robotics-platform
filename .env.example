# Скопируй в .env и поменяй JWT_SECRET. Все значения имеют дефолты в docker-compose.yml.
POSTGRES_USER=robotics
POSTGRES_PASSWORD=robotics
POSTGRES_DB=robotics
POSTGRES_PORT=5432

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Подпись cookie админки (/admin). Если не задано — берётся JWT_SECRET.
ADMIN_COOKIE_SECRET=change-me-too

API_PORT=3000
WEB_PORT=8080

SEED_ADMIN_EMAIL=admin@robotics.local
SEED_ADMIN_PASSWORD=admin12345
SEED_MOCK_PASSWORD=password123
